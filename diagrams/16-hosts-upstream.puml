@startuml 16-hosts-upstream
!include _style.iuml
title Several hosts for one branch, upstreaming (draft)

node "Studio LAN" {
  component "Inkscape A\n(MUPPET)" as a
  component "Inkscape B\n(MUPPET)" as b
  component "Paused branch\n(local, not upstreaming)" as pb
  component "LAN host\n(headless MUPPET,\nin Inkscape A's process)" as lt
}

node "Edge" {
  component "Edge host\n(headless MUPPET)" as et
  component "Browser\n(Wasm MUPPET)" as w
}

node "Server" {
  component "Main host\n(headless MUPPET)" as mt
  database "Branch storage" as st
}

a --> lt : WebSocket
b --> lt : WebSocket
b ..> pb : holds back
pb ..> lt : on release\n(merge)
w --> et : WebSocket
lt --> mt : upstream\n(state-vector sync)
et --> mt : upstream\n(state-vector sync)
mt --> st

note right of mt
  Each host admits edits in its own
  arrival order. An edit admitted by any
  host holding a `host` grant counts
  everywhere. A revocation closes each
  host's door as it reaches it.
end note
@enduml
