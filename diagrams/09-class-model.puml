@startuml 09-class-model
!include _style.iuml
title Core data model: an XML tree on Yrs (draft)

hide empty methods

class "Xmesh document" as Doc <<Yrs Doc>> {
  nodes : Map<NodeId, Node>
  root : NodeId (from genesis)
}

class Node <<Yrs Map>> {
  id = ID of the creating op
  kind : element | text
  name : {namespace}local (elements)
  edges : Map<NodeId, (counter, position)>
  attrs : Map<{ns}name, string> (elements)
  deleted : bool (tombstone)
  content : Text (text nodes)
}

class "ID (Yrs)" as ID <<value>> {
  client : u64
  clock : u32
}

class StateVector <<Yrs>> {
  clocks : map<client, clock>
}

class Snapshot <<Yrs>> {
  state : StateVector
  deleted : DeleteSet
  hash : used in @{snapshot}, ETag
}

class Session {
  address : host/path@name
  parent : address
  fork_at : Snapshot
}

class Trust {
  from : address
  into : address
}

class ClientBinding <<signed>> {
  client
  session : address
  fresh per session + connection
  key : PublicKey
}

class Author {
  public_key : PublicKey
}

Doc *-- "many" Node
Node ..> Node : edges point to\nparents by NodeId
Session --> Snapshot
Snapshot --> StateVector
Trust --> Session : changes merge\nautomatically
ID ..> ClientBinding : client
ClientBinding --> Author : signed by

note right of Node
  "Immortal parents": an element is never
  replaced. Changing @fill updates attrs;
  moving it writes a new edge. Its NodeId
  survives both, so concurrent edits land.
end note
@enduml
