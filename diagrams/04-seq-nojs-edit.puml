@startuml 04-seq-nojs-edit
!include _style.iuml
title No-JS edit: form POST, redirect, cached polling

actor "Browser\n(no JS)" as b
participant "xtxp.link\ngateway" as gw
participant "Server MUPPET\n(acts for this user)" as sm
participant "Host\n(branch main)" as t
participant "Inkscape\nMUPPET" as ink

b -> gw : POST /host/doc@main (form fields)
gw -> sm : edit intent for this user's key
sm -> sm : Xmesh: turn intent into\nCRDT op(s), apply locally
sm -> t : XTXP op (WebSocket)
t -> t : admit, record
t -> ink : fan out op
ink -> ink : Xmesh integrate,\nupdate canvas
t --> sm : echo (acknowledged)
sm --> gw : rendered HTML, new ETag
gw --> b : 303 See Other → GET /host/doc@main
b -> gw : GET /host/doc@main
gw --> b : 200 HTML (ETag: v42)

== passive viewing ==
b -> gw : GET (meta refresh)\nIf-None-Match: v42
alt nothing changed
  gw --> b : 304 Not Modified
else someone else edited
  gw --> b : 200 HTML (ETag: v43)
end

note over sm
  The dumb client is a puppet:
  all CRDT work happens in the
  server-side MUPPET.
end note
@enduml
