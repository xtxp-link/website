@startuml 14-milestones
!include _style.iuml
title Milestones

left to right direction

rectangle "**First**\nM1-y-sweet, M2-y-sweet\n\nthe same milestones\non a stock y-sweet:\nhow much host\ndo we need?" as m0
rectangle "**M1**\nHeadless convergence\n\n3 CLI peers + a headless\nmuppet host, all on Xmesh,\nover WebSocket, replaying\nvectors with forced disconnects" as m1
rectangle "**M2**\nInkscape + no-JS\n\nInkscape fork muppet +\nserver muppet serving\nplain HTML" as m2
rectangle "**M3**\nInkscape + Wasm\n\nbrowser muppet\n(full Wasm peer)" as m3
rectangle "**M4**\nInkscape + Conversations\n\nmobile and chat users\nvia the XMPP bridge\n(scope: open question 7)" as m4

rectangle "**Later**\nThe muppet disco\n\ndiscovery, the bouncer,\nfederation" as disco
card "Live web branching\n(placement: open question 9)" as gw

card "Roadmap\nledger, keyframes,\nhistory limits,\nnative C++ spike,\nElixir/BEAM at scale,\nsigned hash chains" as rm

m0 --> m1 : if XTXP's own\nhost is needed
m1 --> m2
m2 --> m3
m3 --> m4
m4 ..> disco
gw ..> disco : needs the\nbouncer?
m4 ..> rm : when needed
@enduml