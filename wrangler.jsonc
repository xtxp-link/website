// Cloudflare Workers with static assets: serves the built Starlight site from ./dist.
// Deploy with `npm run deploy` (runs `astro build` then `wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtxp-link-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Requires the xtxp.link zone to be on the same Cloudflare account.
  // Remove this block to deploy to a *.workers.dev URL first.
  "routes": [{ "pattern": "xtxp.link", "custom_domain": true }],
  // Lets Cloudflare build preview deployments for branches and pull requests (`wrangler preview`).
  "previews": {}
}
