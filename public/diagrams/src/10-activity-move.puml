@startuml 10-activity-move
!include _style.iuml
title Cycle-safe tree moves (after Evan Wallace)

partition "Writing a move" {
  start
  :move(node, new_parent);
  :c = highest counter in node.edges;
  :node.edges[new_parent] = c + 1\n(a plain map write; old edges stay);
  stop
}

partition "Reading the tree (every peer, same rule)" {
  start
  :for each node, parent = edge with\nthe highest counter (ID breaks ties);
  :nodes that reach the root\nform the tree;
  while (any nodes not rooted?\n(they are in a cycle)) is (yes)
    :pick the next node and an edge to an\nalready-rooted parent: highest counter,\nIDs break ties;
    :reattach it there\n(view only: stored data unchanged);
  endwhile (no)
  :order siblings by fractional index;
  stop
}

note right
  The same converged maps and the
  same rule give the same tree on
  every peer.
  Nothing is rewritten, so peers
  never fight over the fix.
end note
@enduml
