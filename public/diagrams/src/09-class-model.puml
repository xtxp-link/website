@startuml 09-class-model
!include _style.iuml
title Core data model v1: XML on Yrs's own XML types

hide empty methods

class "Xmesh document" as Doc <<Yrs Doc>> {
  root : XmlFragment
  genesis : one fixed update
}

class Element <<Yrs XmlElement>> {
  id = Yrs ID of the creating item
  tag : {namespace}local
  attributes : {ns}name -> string (LWW)
  children : elements and text (YATA order)
}

class Text <<Yrs XmlText>> {
  characters
}

class Special <<XmlElement, reserved name>> {
  comment | processing instruction | CDATA
}

class "ID (Yrs)" as ID <<value>> {
  client : u64
  clock : u32
}

class StateVector <<Yrs>> {
  clocks : map<client, clock>
}

class Snapshot <<Yrs>> {
  state : StateVector
  deleted : DeleteSet
  hash : used in @{snapshot}, ETag
}

class Session {
  address : host/path@name
  parent : address
  fork_at : Snapshot
}

class Trust {
  from : address
  into : address
}

class ClientBinding <<signed>> {
  client
  session : address
  fresh per session + connection
  key : PublicKey
}

class Author {
  public_key : PublicKey
}

Doc *-- Element : root
Element *-- "many" Element : children
Element *-- "many" Text
Element *-- "many" Special
Session --> Snapshot
Snapshot --> StateVector
Trust --> Session : changes merge\nautomatically
ID ..> ClientBinding : client
ClientBinding --> Author : signed by

note right of Element
  v1 move = delete + inserted copy
  (no cycles; known gaps: edits during
  a move, concurrent moves duplicate).
  A tree layer of our own comes later.
end note
@enduml
