@startuml 03-deployment
!include _style.iuml
title Deployment: where each piece runs

node "Desktop" {
  component "Inkscape fork" as ink
  component "MUPPET\n(Xmesh via C interface)" as m1
  ink - m1
}

node "Browser A — no JS" {
  artifact "Plain HTML\nforms + links" as html
}

node "Browser B" {
  component "MUPPET\n(Xmesh in Wasm)" as m2
}

node "Phone" {
  component "XMPP client\n(Conversations-style)" as phone
}

cloud "Edge (Cloudflare or similar)" {
  component "xtxp.link gateway\ncontent negotiation" as gw
}

node "App server" {
  component "Server MUPPET\n(Xmesh, Rust)" as m3
}

node "Tracker server (Rust)\none binary, or one Durable Object per branch" {
  component "WebSocket endpoint" as ws
  component "Tracker: main\n(actor, Xmesh)" as t0
  component "Tracker: branch b1\n(actor, Xmesh)" as t1
  component "Tracker: branch b2\n(actor, Xmesh)" as t2
  database "Branch storage\n(append + compact)" as store
}

node "XMPP bridge (from M4)" {
  component "Bridge component" as br
}

cloud "XMPP federation" as xf

html --> gw : HTTPS
gw --> m3
m1 --> ws : WebSocket (TLS)
m2 --> ws : WebSocket (TLS)
m3 --> ws : WebSocket
phone --> xf : XMPP
xf --> br : XMPP
ws --> t0
ws --> t1
ws --> t2
br --> ws : XTXP
t0 --> store
t1 --> store
t2 --> store
@enduml
