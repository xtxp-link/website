@startuml 03-deployment
!include _style.iuml
title Deployment: where each piece runs

node "Desktop" {
  component "Inkscape fork" as ink
  component "muppet\n(Xmesh via C interface)" as m1
  ink - m1
}

node "Browser A — no JS" {
  artifact "Plain HTML\nforms + links" as html
}

node "Browser B" {
  component "muppet\n(Xmesh in Wasm)" as m2
}

node "Phone" {
  component "XMPP client\n(Conversations-style)" as phone
}

cloud "muppet disco (future milestone)" {
  component "xtxp.link\nfinds hosts; serves no sessions" as gw
}

node "Hosting server: headless muppets\none binary, or one Durable Object per session" {
  component "WebSocket endpoint" as ws
  component "Server muppet\n(renders for no-JS)" as m3
  component "Host: @main\n(headless muppet)" as t0
  component "Host: @sketch\n(headless muppet)" as t1
  component "Host: @review\n(headless muppet)" as t2
  database "Session storage\n(append + compact)" as store
}

node "XMPP bridge (from M4)" {
  component "Bridge component" as br
}

cloud "XMPP federation" as xf

html --> m3 : HTTPS
html ..> gw : lookup, then\nredirect to the host
m1 --> ws : WebSocket (TLS)
m2 --> ws : WebSocket (TLS)
m3 --> ws : in process
phone --> xf : XMPP
xf --> br : XMPP
ws --> t0
ws --> t1
ws --> t2
br --> ws : XTXP
t0 --> store
t1 --> store
t2 --> store
@enduml
