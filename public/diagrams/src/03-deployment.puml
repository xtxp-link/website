@startuml 03-deployment
!include _style.iuml
title Deployment: where each piece runs

node "Desktop" {
  component "Inkscape fork" as ink
  component "MUPPET\n(C++ Xmesh)" as m1
  ink - m1
}

node "Browser A — no JS" {
  artifact "Plain HTML\nforms + links" as html
}

node "Browser B" {
  component "MUPPET\n(Wasm Xmesh)" as m2
}

node "Phone" {
  component "XMPP client\n(Conversations-style)" as phone
}

cloud "Edge (Cloudflare or similar)" {
  component "xtxp.link gateway\ncontent negotiation" as gw
}

node "App server" {
  component "Server MUPPET\n(C++ Xmesh)" as m3
}

node "BEAM cluster" {
  component "WebSocket endpoint\n(Phoenix / Cowboy)" as ws
  component "XMPP bridge\n(from M4)" as br
  component "Tracker: main" as t0
  component "Tracker: branch b1" as t1
  component "Tracker: branch b2" as t2
  component "Xmesh core processes\n(C++, via Ports)" as core
  database "Keyframes (hot)" as hot
  database "Ledger (cold)" as cold
}

cloud "XMPP federation" as xf

html --> gw : HTTPS
gw --> m3
m1 --> ws : WebSocket (TLS)
m2 --> ws : WebSocket (TLS)
m3 --> ws : WebSocket
phone --> xf : XMPP
xf --> br : XMPP
ws --> t0
ws --> t1
ws --> t2
br --> t0
t0 --> core
t1 --> core
t2 --> core
t0 --> hot
t0 --> cold
@enduml
