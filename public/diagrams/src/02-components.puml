@startuml 02-components
!include _style.iuml
title Components and the contract between them

package "XTXP — the specification" as spec {
  interface "The Math\n(merge rules, tree moves,\npatch structures)" as math
  interface "The Wire\n(sync messages, handshakes,\nbranch routing)" as wire
}

package "Xmesh — the engine (Rust)" as engine {
  component "Xmesh\n(pure: XML on Yrs XML types,\nXML Patch, canonical XML)" as xm
  component "Yrs\n(YATA, maps, text,\nstate vectors, updates)" as yrs
  component "Native C++ Xmesh\n<<later spike>>" as xcpp #line.dashed
}

package "MUPPET — the executor (Xmesh plus views)" as muppet {
  component "Inkscape adapter\n<<C++, in the fork>>" as mink
  component "Browser adapter\n<<Wasm>>" as mwasm
  component "Server MUPPET\n<<renders HTML/SVG for no-JS>>" as msrv
  component "Canvas, spatial chat\nand comments\n(views, shared by all adapters)" as mviews
}

package "MUPPET hosting a session (headless)" as hosting {
  component "Host\n(admit, route, store;\nmerges from trusted sessions)" as session
  database "Session storage\n(append + compact;\nledger on the roadmap)" as store
}

xm --> yrs : built on
xm ..|> math
xcpp ..|> math : later
mink --> xm : C interface
mwasm --> xm : Wasm build
msrv --> xm : Rust
session --> xm : Rust
mink ..> wire
mwasm ..> wire
msrv ..> wire
session ..> wire
session --> store

note bottom of engine
  Pure core: no I/O, no clocks, no threads.
  Every integration is an adapter. The vector
  suite holds any later rewrite to the same results.
end note
@enduml
