@startuml 01-context
!include _style.iuml
title System context: who talks to the XTXP mesh

left to right direction

actor "Designer\n(Inkscape fork)" as designer
actor "Browser user\n(Wasm client)" as wasm
actor "Browser user\n(no JavaScript)" as nojs
actor "Mobile / chat user\n(XMPP client)" as mobile

rectangle "XTXP mesh" as mesh {
  component "Peers running\nMUPPET + Xmesh" as peers
  component "Hosts\n(headless MUPPETs;\nsessions merge by trust)" as hosts
  component "Server MUPPET on a host\n(acts for the user)" as server
}

rectangle "Muppet disco\n(xtxp.link, or anyone's)\nfinds sessions, hosts none\n(future milestone)" as disco
component "XMPP bridge" as bridge
rectangle "Origin websites\n(e.g. en.wikipedia.org)" as origin
rectangle "Sign-in provider\n(Google, Apple, Mozilla)\n+ user's own storage" as sso

designer --> peers : edits SVG natively
wasm --> peers : edits in browser
nojs --> server : HTML forms,\nlinks, HTTP caching
mobile --> bridge : chat, comments,\npush when asleep
server --> hosts : in process
peers --> hosts : XTXP over WebSocket
bridge --> hosts : XTXP
hosts ..> origin : genesis fetch\n(no cookies forwarded)
peers ..> sso : fetch own private key\nafter sign-in
peers ..> disco : signed query:\nwhich sessions may I see?

' Keep the actors in reading order, top to bottom: designer, Wasm, no-JS, mobile.
designer -[hidden]right- wasm
wasm -[hidden]right- nojs
nojs -[hidden]right- mobile

note top of nojs
  North star: the no-JS browser
  is a full participant, not a fallback.
end note
@enduml
