@startuml 16-session-trust
!include _style.iuml
title Sessions on different hosts, linked by trust (draft)

node "Server: xtxp.example.org" {
  component "drawing@main" as main
}

node "Studio LAN: studio.lan\n(Inkscape A hosting)" {
  component "drawing@studio" as studio
  component "Inkscape A\n(MUPPET)" as ia
  component "Inkscape B\n(MUPPET)" as ib
}

node "Laptop: my-laptop.lan" {
  component "drawing@sketch\n(paused: automatic\nmerge into main off)" as sketch
}

ia --> studio : edits
ib --> studio : edits
studio <--> main : trust both ways:\nchanges merge\nautomatically
sketch <.. main : sketch trusts main:\nstays current
sketch ..> main : on release:\nmain trusts sketch\n(an ordinary merge)

note bottom of main
  Each session lives on exactly one host,
  and only that host admits edits to it.
  Trust between sessions decides which
  changes merge in automatically.
  Merges commute, so two-way trust
  can't loop or diverge.
end note
@enduml
