---
// The animated XTXP logo, inline so it can use the theme's colours (see src/styles/logo.generated.css).
//   mode="loop"  builds, holds, reverses and repeats (the hero)
//   mode="title" still, until something adds .xtxp-logo--run (the site title)
import { glyphs, VIEWBOX } from '../brand/logo.mjs';

interface Props {
  mode?: 'loop' | 'title';
  class?: string;
}
const { mode = 'loop', class: className } = Astro.props;
---

<svg
  class:list={['xtxp-logo', mode === 'loop' && 'xtxp-logo--loop', className]}
  viewBox={VIEWBOX}
  aria-hidden="true"
  focusable="false"
  set:html={glyphs()}
/>
