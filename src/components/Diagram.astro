---
/**
 * A PlantUML diagram rendered to SVG by scripts/render-diagrams.sh.
 * Ships both a light and a dark variant and lets CSS pick, so it needs no JavaScript.
 * The diagram fits the column; selecting it follows a plain link to its viewer page
 * (/d/{name}/{theme}/) in the matching theme, so every diagram is addressable on its own.
 */
interface Props {
  name: string; // file name without extension, e.g. "07-seq-branch"
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const base = '/diagrams';
---

<figure class="xtxp-diagram">
  <a href={`/d/${name}/light/`} class="xtxp-diagram__img xtxp-diagram__img--light">
    <img src={`${base}/light/${name}.svg`} alt={alt} loading="lazy" decoding="async" />
  </a>
  <a href={`/d/${name}/dark/`} class="xtxp-diagram__img xtxp-diagram__img--dark">
    <img src={`${base}/dark/${name}.svg`} alt={alt} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    {caption && <span>{caption}</span>}
    <span class="xtxp-diagram__links">
      <span>Select the diagram to view it full screen</span>
      <a href={`https://github.com/xtxp-link/website/blob/main/diagrams/${name}.puml`}>PlantUML source</a>
    </span>
  </figcaption>
</figure>
