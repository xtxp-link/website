---
// Splash hero. Same as Starlight's, except the H1 is the animated logo (the title text stays for readers
// and search engines) and there is no image column. Everything is centred on the page's centre line, which the
// logo's red + sits on. The paragraph is a centred block with left-aligned text.
//
// A small control sits under the logo's right edge: a pause/play button whose icon shows the current state (> while the logo builds, < while it reverses, || while paused) (WCAG 2.2.2: the loop would otherwise run
// forever) and, on hover or focus, a seek slider spanning the logo's full width. The slider shows how built the logo is: it reaches the end when the xtxp is complete, rests there, and returns to the start as the logo reverses to the x. The button is in the page and keyboard-focusable from the start,
// and fades in once the first build has finished, about 2.7 seconds in, inside the five seconds the criterion allows.
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import Logo from './Logo.astro';
import { TF, TOTAL, HOLD, R0, HERO_DELAY } from '../brand/logo.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const showControlAt = +(HERO_DELAY + TF + 0.3).toFixed(2); // seconds after load
// With no JavaScript there is no control, so the loop plays the build once and stops on the full logo.
const noJsIterations = +((TF + HOLD / 2) / TOTAL).toFixed(4);
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <div class="logo-block" data-total={TOTAL} data-build={TF} data-reverse={R0} data-delay={HERO_DELAY} style={`--ctl-delay:${showControlAt}s;--hero-delay:${HERO_DELAY}s`}>
        <h1 id="_top" data-page-title>
          <Logo mode="loop" centre="plus" class="xtxp-hero-logo" />
          <span class="sr-only" set:html={title} />
        </h1>
        <div class="xtxp-ctl">
          <label class="sr-only" for="xtxp-seek">Seek through the logo animation</label>
          <input id="xtxp-seek" type="range" min="0" max={TF} step="0.005" value="0" aria-valuetext="0% built" />
          <button type="button" class="xtxp-play" aria-label="Pause logo animation" aria-pressed="false">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="xtxp-edge" gradientUnits="userSpaceOnUse" x1="5" y1="0" x2="15" y2="0">
                  <stop offset="0" stop-color="var(--sl-color-white)"></stop>
                  <stop offset="0.55" stop-color="var(--sl-color-white)"></stop>
                  <stop offset="1" stop-color="#ff5436"></stop>
                </linearGradient>
                <linearGradient id="xtxp-edge-rev" gradientUnits="userSpaceOnUse" x1="15" y1="0" x2="5" y2="0">
                  <stop offset="0" stop-color="var(--sl-color-white)"></stop>
                  <stop offset="0.55" stop-color="var(--sl-color-white)"></stop>
                  <stop offset="1" stop-color="#ff5436"></stop>
                </linearGradient>
              </defs>
              <!-- The icon shows the current state. While the logo builds it is the logo's > chevron, tip accented;
                   while the logo reverses it is a < (the > shrinks to a dot and the < grows out of it, and back again),
                   all driven by the same timeline as the logo. Paused: two bars in one colour. -->
              <g class="icon-play" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path class="chev chev-fwd" d="M7 3.8L14.2 10L7 16.2" stroke="url(#xtxp-edge)"></path>
                <path class="chev chev-rev" d="M13 3.8L5.8 10L13 16.2" stroke="url(#xtxp-edge-rev)"></path>
                <circle class="chev-dot" cx="10" cy="10" r="1.5" fill="var(--sl-color-white)" stroke="none"></circle>
              </g>
              <g class="icon-pause" fill="none" stroke-width="2.6" stroke-linecap="round">
                <path d="M7 4.5V15.5" stroke="var(--sl-color-white)"></path>
                <path d="M13 4.5V15.5" stroke="var(--sl-color-white)"></path>
              </g>
            </svg>
          </button>
        </div>
      </div>
      {data.draft && <DraftContentNotice />}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            )
          )}
        </div>
      )
    }
  </div>
</div>

<noscript>
  <style
    set:html={`.xtxp-hero-logo *{animation-iteration-count:${noJsIterations}!important}.xtxp-ctl{display:none}`}
  ></style>
</noscript>

<script>
  const block = document.querySelector<HTMLElement>('.logo-block');
  const logo = block?.querySelector<SVGElement>('.xtxp-logo');
  const button = block?.querySelector<HTMLButtonElement>('.xtxp-play');
  const seek = block?.querySelector<HTMLInputElement>('#xtxp-seek');

  if (block && logo && button && seek) {
    const total = parseFloat(block.dataset.total ?? '0');
    const build = parseFloat(block.dataset.build ?? '0'); // the build runs from 0 to here, and the slider with it
    const reverseAt = parseFloat(block.dataset.reverse ?? '0'); // when the reverse starts
    const delay = parseFloat(block.dataset.delay ?? '0'); // the loop's first iteration waits for the fade-in
    let userPaused = false;
    let onScreen = true;
    let showing = false;
    let frame = 0;

    // The logo's animations, then the button icon's (same timeline, so one pause/seek moves both).
    const anims = () => [...logo.getAnimations({ subtree: true }), ...button.getAnimations({ subtree: true })];

    const apply = () => {
      const paused = userPaused || !onScreen;
      anims().forEach((a) => (paused ? a.pause() : a.play()));
    };

    const setPaused = (paused: boolean) => {
      userPaused = paused;
      button.dataset.paused = String(paused);
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', paused ? 'Play logo animation' : 'Pause logo animation');
      apply();
    };

    // How built the logo is, in build-seconds: 0 is the lone x, `build` is the finished xtxp. It rises during the build,
    // rests at the end through the hold, falls back to 0 as the logo reverses, and rests at 0 before the loop restarts.
    const position = () => {
      const t = anims()[0]?.currentTime;
      if (typeof t !== 'number') return 0;
      const s = Math.max(0, (t / 1000 - delay) % total);
      if (s < build) return s;
      if (s < reverseAt) return build;
      if (s < reverseAt + build) return build - (s - reverseAt);
      return 0;
    };

    const describe = (s: number) => seek.setAttribute('aria-valuetext', `${Math.round((s / build) * 100)}% built`);

    // Keep the thumb on the animation while the slider is on show.
    const follow = () => {
      if (!showing) return;
      if (document.activeElement !== seek || !seek.matches(':active')) {
        const s = position();
        seek.value = String(s);
        describe(s);
      }
      frame = requestAnimationFrame(follow);
    };
    const startFollowing = () => {
      if (showing) return;
      showing = true;
      frame = requestAnimationFrame(follow);
    };
    const stopFollowing = () => {
      showing = false;
      cancelAnimationFrame(frame);
    };
    const ctl = block.querySelector('.xtxp-ctl');
    ctl?.addEventListener('pointerenter', startFollowing);
    ctl?.addEventListener('focusin', startFollowing);
    ctl?.addEventListener('pointerleave', () => {
      if (!ctl.matches(':focus-within')) stopFollowing();
    });
    ctl?.addEventListener('focusout', () => {
      if (!ctl.matches(':hover')) stopFollowing();
    });

    button.addEventListener('click', () => setPaused(!userPaused));

    // Dragging the slider scrubs the logo through its build (it shows the build state at that point) and pauses it;
    // press play to carry on from there.
    seek.addEventListener('input', () => {
      const s = parseFloat(seek.value);
      if (!userPaused) setPaused(true);
      anims().forEach((a) => {
        a.pause();
        a.currentTime = (s + delay) * 1000;
      });
      describe(s);
    });

    // Don't spend battery on a logo nobody can see.
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      apply();
    }).observe(logo);
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 100%;
    padding-block: clamp(2rem, calc(1rem + 8vmin), 7rem);
    min-height: 0;
  }
  .stack {
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
  }
  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    width: 100%;
  }
  .copy > * {
    max-width: 50ch;
  }

  .logo-block {
    position: relative;
    width: min(34rem, 100%);
    max-width: none;
    margin-inline: auto;
    padding-bottom: 2rem; /* room for the control, so nothing shifts when it appears */
  }
  /* Galaxy fades the H1 up from 30px below; keep only a short fade, no slide. */
  .hero h1[data-page-title] {
    margin: 0;
    line-height: 1;
    max-width: none;
    width: 100%;
    animation: xtxp-fade 0.4s ease-out both;
  }
  h1 :global(.xtxp-hero-logo) {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  /* The loop waits for the fade to finish. */
  h1 :global(.xtxp-logo--loop.xtxp-hero-logo *) {
    animation-delay: var(--hero-delay);
  }

  /* Pause / seek control: a strip under the logo. The button sits at the right; the slider fills the rest of the row. */
  .xtxp-ctl {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    /* The button takes 1.75rem + the gap on the right; leave the same on the left so the slider is centred on the logo. */
    padding-left: calc(1.75rem + 0.75rem);
    box-sizing: border-box;
    animation: xtxp-ctl-in 0.5s ease-out var(--ctl-delay) both;
  }
  .xtxp-ctl:focus-within {
    animation: none;
    opacity: 1;
  }
  .xtxp-ctl input[type='range'] {
    flex: 1;
    min-width: 0;
    height: 1.75rem;
    margin: 0;
    opacity: 0;
    accent-color: var(--sl-color-accent);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  /* Shown on hover or focus, and whenever the logo is paused so it can be scrubbed. */
  .xtxp-ctl:hover input[type='range'],
  .xtxp-ctl:focus-within input[type='range'],
  .xtxp-ctl:has(.xtxp-play[data-paused='true']) input[type='range'] {
    opacity: 1;
  }
  .xtxp-play {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    background: transparent;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .xtxp-ctl:hover .xtxp-play,
  .xtxp-play:focus-visible {
    opacity: 1;
    border-color: var(--sl-color-gray-5);
  }
  .xtxp-play:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .xtxp-play svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .xtxp-play .icon-pause {
    display: none;
  }
  .xtxp-play[data-paused='true'] .icon-pause {
    display: inline;
  }
  .xtxp-play[data-paused='true'] .icon-play {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .xtxp-ctl {
      display: none;
    }
    .hero h1[data-page-title] {
      animation: none;
    }
  }

  .tagline {
    text-align: start;
    max-width: 42ch;
    text-wrap: pretty;
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-4);
    margin-block: 0;
  }
  .tagline :global(strong) {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .actions {
    gap: 1rem 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Galaxy pads the hero by 2rem+ each side on top of the page's own gutter, which leaves a phone's copy column narrow. */
  @media (max-width: 50rem) {
    .hero {
      padding-inline: 0;
    }
  }
</style>
