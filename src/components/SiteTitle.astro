---
// Site title: the small logo. Still until hovered or focused, then it plays the reverse-and-rebuild once.
// Moving away lets it finish, so it always lands on the full logo.
// On the home page the hero already shows the big logo, so this one stays tucked away until the hero scrolls out of view.
import Logo from './Logo.astro';
const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const tuck = entry.data.template === 'splash';
---

<a href={siteTitleHref} class="site-title xtxp-title sl-flex" data-tuck={tuck ? '' : undefined}>
  <Logo mode="title" />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

{
  tuck && (
    <noscript>
      <style>{`.xtxp-title[data-tuck]{opacity:1!important;visibility:visible!important}`}</style>
    </noscript>
  )
}

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.xtxp-title').forEach((link) => {
    const logo = link.querySelector('.xtxp-logo');
    if (!logo) return;

    if (!reduce) {
      const start = () => logo.classList.add('xtxp-logo--run');
      link.addEventListener('pointerenter', start);
      link.addEventListener('focus', start);
      logo.addEventListener('animationend', (e) => {
        if ((e as AnimationEvent).animationName === 'xl-p') logo.classList.remove('xtxp-logo--run');
      });
    }

    // Home page: show the header logo once the hero logo has scrolled away.
    const hero = document.querySelector('.xtxp-hero-logo');
    if (link.hasAttribute('data-tuck') && hero) {
      new IntersectionObserver(([entry]) => {
        link.classList.toggle('is-shown', !entry.isIntersecting);
      }).observe(hero);
    }
  });
</script>

<style>
  .xtxp-title {
    align-items: center;
    min-width: 0;
  }
  .xtxp-title :global(.xtxp-logo) {
    height: 1.55rem;
    width: auto;
    overflow: visible;
  }
  .xtxp-title[data-tuck]:not(.is-shown) {
    opacity: 0;
    visibility: hidden;
  }
  .xtxp-title[data-tuck] {
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0s;
  }
  .xtxp-title[data-tuck]:not(.is-shown) {
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }
</style>
