TL.sort((a,b) => a.t - b.t);
const stateAt = T => {
  const s = init();
  for (const k of TL) { if (T < k.t) break; const p = k.d ? Math.min(1,(T-k.t)/k.d) : 1; k.fn(s,k.e(p)); }
  return s;
};

/* ---------- geometry ---------- */
const clamp01 = v => v < 0 ? 0 : v > 1 ? 1 : v;
const BOX = { browser:[280,180], ink:[280,180], legacy:[280,180], phone:[85,170] };
const ep = (s,n,tx,ty,m=10) => {
  const d = s.dev[n]; let vx = tx-d.x, vy = ty-d.y; const L = Math.hypot(vx,vy) || 1; vx /= L; vy /= L;
  if (n === 'hex') { const r = 25*d.s + m; return [d.x+vx*r, d.y+vy*r]; }
  if (n === 'mesh') { const b = clamp01(s.logo.mesh-1), rx = (56+100*b)*d.s + m, ry = (56+14*b)*d.s + m; const r = 1/Math.hypot(vx/rx, vy/ry); return [d.x+vx*r, d.y+vy*r]; }
  const [hw,hh] = BOX[n], sx = hw*d.s, sy = hh*d.s;
  const t = Math.min(Math.abs(vx) > 1e-6 ? sx/Math.abs(vx) : 1e9, Math.abs(vy) > 1e-6 ? sy/Math.abs(vy) : 1e9);
  return [d.x+vx*(t+m), d.y+vy*(t+m)];
};
const curve = (s,a,b,bend) => {
  const A = s.dev[a], B = s.dev[b];
  const vx = B.x-A.x, vy = B.y-A.y, L = Math.hypot(vx,vy) || 1;
  const cx = (A.x+B.x)/2 - vy/L*bend, cy = (A.y+B.y)/2 + vx/L*bend;
  const p0 = bend ? ep(s,a,cx,cy) : ep(s,a,B.x,B.y), p1 = bend ? ep(s,b,cx,cy) : ep(s,b,A.x,A.y);
  return `M${p0[0].toFixed(1)},${p0[1].toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${p1[0].toFixed(1)},${p1[1].toFixed(1)}`;
};

/* ---------- render ---------- */
const el = {};
['root','browser','ink','phone','legacy','hex','mesh','browser-x','ink-x','phone-xf','phone-xc','legacy-x','ink-sel','ink-rot','ink-toolhl','ink-sw',
 'phone-card','phone-full','touch','undo-pop','legacy-ph','legacy-page','legacy-spin','legacy-dim','legacy-dlg','legacy-radio','hex-pulse','mesh-glow',
 'links','arrows','labels','cap'].forEach(k => el[k] = $(k));
['browser','ink','legacy'].forEach(n => { el[n+'-cur'] = $(n+'-cur'); el[n+'-ring'] = $(n+'-ring'); });

const setX = (g,m,cx,cy,k) => {
  g.setAttribute('transform', `translate(${cx+m.dx*k},${cy+m.dy*k}) rotate(${m.rot}) scale(${k})`);
  g.querySelector('.xb').setAttribute('stroke', m.c);
};
const logoEl = id => { const g = $(id); return { g, c:g.querySelector('.c'), l:g.querySelector('.l'), r:g.querySelector('.r'), ols:[...g.querySelectorAll('.ol')], p:g.querySelector('.p') }; };
const LG = { browser:logoEl('browser-logo'), ink:logoEl('ink-logo'), phone:logoEl('phone-logo'), legacy:logoEl('legacy-logo'), mesh:logoEl('mesh-logo') };
// L: 0 x, 1 +, 2 +++, 3 x+x, 4 <+>, 5 xtxp. base = scale of the lone x; zEnd = zoom once it has branched.
function renderLogo(o, L, pal, cx, cy, base, zEnd) {
  const a = clamp01(L), b = clamp01(L-1), c3 = clamp01(L-2), d = clamp01(L-3), e = clamp01(L-4);
  const S = base*(1 + (zEnd-1)*E.io(b)), sh = 32 + 21*E.io(e);
  o.g.setAttribute('transform', `translate(${cx},${cy}) scale(${S}) translate(${-sh},0)`);
  o.c.setAttribute('transform', `translate(32,0) rotate(${45*a}) scale(${1-.394*a})`);
  o.c.setAttribute('stroke-width', 6 + 3.9*a);
  o.c.setAttribute('stroke', mix(pal.x, pal.t, clamp01(a/.4)));
  [[o.l,-1],[o.r,1]].forEach(([g,dir]) => {
    g.setAttribute('opacity', b > 0 ? 1 : 0);
    g.setAttribute('transform', `translate(${32 + dir*32*E.back(b)},0) rotate(${dir*45*(1-c3)}) scale(${.606 + .394*c3})`);
    g.setAttribute('stroke-width', 9.9 - 3.9*c3);
    g.setAttribute('stroke', mix(pal.t, pal.x, clamp01(c3/.4)));
  });
  o.ols.forEach(q => q.setAttribute('stroke-dashoffset', d - e));
  o.p.setAttribute('opacity', e > 0 ? 1 : 0);
  o.p.setAttribute('stroke-dashoffset', 1 - e);
  o.p.setAttribute('stroke', pal.p);
}

const arrowEls = {};
const getArrow = id => {
  if (!arrowEls[id]) {
    const g = document.createElementNS(NS,'g');
    const mk = () => document.createElementNS(NS,'path');
    const back = mk(), p = mk(), h = mk();
    back.setAttribute('fill','none'); back.setAttribute('stroke',C.line); back.setAttribute('stroke-width','10'); back.setAttribute('stroke-linecap','round'); back.setAttribute('stroke-opacity','.6');
    p.setAttribute('fill','none'); p.setAttribute('stroke-width','5'); p.setAttribute('stroke-linecap','round');
    h.setAttribute('d','M2,0 L-15,-10 L-11,0 L-15,10 Z'); h.setAttribute('stroke',C.line); h.setAttribute('stroke-width','1.5'); h.setAttribute('stroke-linejoin','round');
    g.append(back,p,h); el.arrows.append(g); arrowEls[id] = { g, back, p, h };
  }
  return arrowEls[id];
};

const LINKS = [['browser','mesh'],['ink','mesh'],['phone','mesh'],['hex','mesh'],['legacy','hex']];
const linkEls = LINKS.map(() => {
  const p = document.createElementNS(NS,'path');
  p.setAttribute('fill','none'); p.setAttribute('stroke',C.mute); p.setAttribute('stroke-width','3'); p.setAttribute('stroke-dasharray','2 10'); p.setAttribute('stroke-linecap','round'); p.setAttribute('stroke-opacity','.75');
  const dots = [0,1].map(() => { const c = document.createElementNS(NS,'circle'); c.setAttribute('r','5'); c.setAttribute('fill',C.red); return c; });
  el.links.append(p, ...dots); return { p, dots };
});

function render(s, T) {
  el.root.setAttribute('opacity', s.g.o);
  for (const n of ['browser','ink','phone','legacy','hex','mesh']) {
    const d = s.dev[n];
    el[n].setAttribute('transform', `translate(${d.x},${d.y}) scale(${d.s})`);
    el[n].setAttribute('opacity', d.o);
  }
  setX(el['browser-x'], s.x.browser, ...ANCH.browser);
  setX(el['ink-x'], s.x.ink, ...ANCH.ink);
  setX(el['legacy-x'], s.x.legacy, ...ANCH.legacy);
  setX(el['phone-xf'], s.x.phone, ...ANCH.phoneFull);
  setX(el['phone-xc'], s.x.phone, ...ANCH.phoneCard);
  const docs = { browser:['browser-x',ANCH.browser], ink:['ink-x',ANCH.ink], phone:['phone-xf',ANCH.phoneFull], legacy:['legacy-x',ANCH.legacy] };
  for (const n in docs) {
    const [xid,[cx,cy,k]] = docs[n];
    el[xid].style.display = s.logoMode ? 'none' : '';
    LG[n].g.style.display = s.logoMode ? '' : 'none';
    if (s.logoMode) renderLogo(LG[n], s.logo[n], LOGO_LIGHT, cx, cy, 4*k, .6);
  }
  const mb = clamp01(s.logo.mesh-1);
  renderLogo(LG.mesh, s.logo.mesh, LOGO_DARK, 0, 0, 1.55, 1.3);
  $('mesh-ring').setAttribute('opacity', 1 - mb);
  el['mesh-glow'].setAttribute('opacity', .06 - .035*mb);
  const mp = s.dev.mesh.pulse;
  el['mesh-glow'].setAttribute('rx', 74 + 80*mb + (mp < 1 ? 14*Math.sin(mp*Math.PI) : 0));
  el['mesh-glow'].setAttribute('ry', 74 - 4*mb + (mp < 1 ? 10*Math.sin(mp*Math.PI) : 0));

  for (const n of ['browser','ink','legacy']) {
    const c = s.cur[n], cs = Math.min(1.7, .85/s.dev[n].s);
    const g = el[n+'-cur'];
    g.setAttribute('transform', `translate(${c.x},${c.y}) scale(${cs*(1-.15*c.down)})`);
    g.setAttribute('opacity', c.o);
    for (const k of g.children) k.style.display = k.dataset.k === c.k ? '' : 'none';
    const r = el[n+'-ring'];
    r.setAttribute('transform', `translate(${c.x},${c.y}) scale(${cs*(1+1.8*c.ring)})`);
    r.setAttribute('opacity', c.ring < 1 ? (1-c.ring)*c.o : 0);
  }

  el['ink-sel'].setAttribute('opacity', s.ink.sel);
  el['ink-rot'].setAttribute('opacity', s.ink.rot);
  el['ink-toolhl'].setAttribute('y', toolY(s.ink.tool) - 13);
  if (s.ink.swatch < 0) el['ink-sw'].setAttribute('opacity', 0);
  else { el['ink-sw'].setAttribute('opacity', 1); el['ink-sw'].setAttribute('x', -239 + s.ink.swatch*30); }

  el['phone-card'].setAttribute('opacity', s.phone.card);
  el['phone-card'].setAttribute('transform', `translate(0,${(1-s.phone.card)*14})`);
  const f = s.phone.full;
  el['phone-full'].setAttribute('opacity', Math.min(1, f*2.5));
  el['phone-full'].setAttribute('transform', `translate(${-15*(1-f)},${8*(1-f)}) scale(${.3+.7*f})`);
  const u = s.phone.undo;
  el['undo-pop'].setAttribute('opacity', Math.min(1, u*3));
  el['undo-pop'].setAttribute('transform', `translate(0,-6) scale(${Math.max(0,u)})`);
  el.touch.setAttribute('opacity', s.touch.p < 1 ? 1-s.touch.p : 0);
  el.touch.setAttribute('transform', `translate(${s.touch.x},${s.touch.y})`);
  el.touch.querySelector('.tr').setAttribute('r', 10 + 18*s.touch.p);

  el['legacy-ph'].setAttribute('opacity', 1 - s.legacy.loaded);
  el['legacy-page'].setAttribute('opacity', s.legacy.loaded);
  el['legacy-spin'].setAttribute('transform', `translate(-145,-129) rotate(${s.legacy.spin*360})`);
  el['legacy-dim'].setAttribute('opacity', s.legacy.dim*.92);
  el['legacy-dlg'].setAttribute('opacity', s.legacy.dialog);
  el['legacy-dlg'].style.display = s.legacy.dialog > 0 ? '' : 'none';
  el['legacy-radio'].setAttribute('cy', -30 + s.legacy.radio*24);

  const hp = s.dev.hex.pulse;
  el['hex-pulse'].setAttribute('r', 24 + 34*hp);
  el['hex-pulse'].setAttribute('opacity', hp < 1 ? 1-hp : 0);

  // links (final scene)
  el.links.setAttribute('opacity', s.links);
  if (s.links > 0) LINKS.forEach(([a,b],i) => {
    const A = s.dev[b], B = s.dev[a];
    const p0 = ep(s,a,A.x,A.y,4), p1 = ep(s,b,B.x,B.y,4);
    const L = linkEls[i];
    L.p.setAttribute('d', `M${p0[0]},${p0[1]} L${p1[0]},${p1[1]}`);
    L.p.setAttribute('stroke-dashoffset', (-T*30).toFixed(1));
    L.dots.forEach((c,j) => {
      let u = (T*.45 + j*.5 + i*.17) % 1; if (j === 1) u = 1 - u;   // one pulse each way
      c.setAttribute('cx', p0[0] + (p1[0]-p0[0])*u); c.setAttribute('cy', p0[1] + (p1[1]-p0[1])*u);
      c.setAttribute('opacity', Math.sin(u*Math.PI));
    });
  });

  // arrows
  for (const id in arrowEls) arrowEls[id].g.style.display = 'none';
  for (const id in s.arrows) {
    const a = s.arrows[id];
    if (a.o <= 0 || a.p <= .01) continue;
    const A = getArrow(id);
    A.g.style.display = ''; A.g.setAttribute('opacity', a.o);
    const d = curve(s,a.a,a.b,a.bend);
    A.p.setAttribute('d', d); A.back.setAttribute('d', d);
    const len = A.p.getTotalLength(), head = len*a.p;
    const dash = `${Math.max(0, head-10)} ${len+40}`;
    A.p.setAttribute('stroke-dasharray', dash); A.back.setAttribute('stroke-dasharray', dash);
    A.p.setAttribute('stroke', a.col); A.h.setAttribute('fill', a.col);
    const q = A.p.getPointAtLength(head), q0 = A.p.getPointAtLength(Math.max(0, head-4));
    const ang = Math.atan2(q.y-q0.y, q.x-q0.x)*180/Math.PI;
    A.h.setAttribute('transform', `translate(${q.x},${q.y}) rotate(${ang})`);
  }

  // labels
  el.labels.setAttribute('opacity', s.labels);
  if (s.labels > 0) for (const n in LABELS) {
    const d = s.dev[n], t = $('lab-' + n);
    const below = n === 'hex' ? 42 : n === 'mesh' ? 84 : BOX[n][1]*d.s + 24;
    t.setAttribute('x', d.x); t.setAttribute('y', d.y + below);
  }

  el.cap.textContent = s.cap.text;
  el.cap.setAttribute('opacity', SHOW_CAPTIONS ? s.cap.o : 0);
}

/* ---------- playback ---------- */
const q = new URLSearchParams(location.search);
const fixed = q.has('t') ? +q.get('t') : null;
const speed = +q.get('speed') || 1;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
let elapsed = 0, last = null, playing = true, visible = true;
svg.addEventListener('click', () => { if (elapsed >= END) { elapsed = 0; playing = true; } else playing = !playing; });
if ('IntersectionObserver' in window) new IntersectionObserver(es => { visible = es[0].isIntersecting; }).observe(svg);

if (fixed != null) render(stateAt(fixed), fixed);
else if (reduce) render(stateAt(END), END);
else {
  const frame = now => {
    if (last != null && playing && visible) elapsed += (now-last)/1000*speed;
    last = now;
    render(stateAt(Math.min(elapsed, END)), elapsed);
    requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
}
window.xtxpHeroSeek = t => { elapsed = t; };   // console helper while tuning
})();
</script>
